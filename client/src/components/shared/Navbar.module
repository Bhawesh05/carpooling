.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 2rem;
  height: 60px;
  background: #fff;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.3rem;
  font-weight: 700;
  color: #2563eb;
}

.links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  font-size: 0.95rem;
}

.links a {
  color: #555;
  transition: color 0.2s;
}

.links a:hover {
  color: #2563eb;
}

.username {
  color: #888;
  font-size: 0.9rem;
}

.registerBtn {
  background: #2563eb;
  color: #fff !important;
  padding: 0.4rem 1rem;
  border-radius: 6px;
}

.logoutBtn {
  background: none;
  border: 1px solid #ddd;
  padding: 0.35rem 0.9rem;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.9rem;
  color: #555;
}

.logoutBtn:hover {
  background: #f5f5f5;
}
